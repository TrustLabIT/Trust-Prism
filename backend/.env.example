# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas — paste your connection string (Atlas → Connect → Drivers)
# Looks like: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/trustprism?retryWrites=true&w=majority
MONGO_URI=

# JWT — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PACE identity-hub provisioning token (create / enable / disable logins from PACE).
# The active token lives in a file at the backend root (provisioning_token),
# rotatable from PACE; this env var is the fallback.
PROVISIONING_TOKEN=

# CMD Approval Hub — one inbox where approvals from several TrustLab systems are
# decided. From Trust Prism it shows what the Super Admin sees on "Approvals &
# governance" and in the Version Tracker, and its user (the CMD, the Super Admin
# here) decides them there. Leave all three empty and Trust Prism is not part of it.
# CMD_HUB_API_KEY      the key the hub's server sends as X-Api-Key to
#                      /api/cmdhub/*. Same value as HUB_API_KEY (or
#                      PRISM_API_KEY) in the hub's .env. Unset = those
#                      endpoints are off (503).
# CMD_HUB_WEBHOOK_URL  where an asset sent for approval (or moving on) is
#                      announced: https://<hub host>/api/hooks/prism/changed
# CMD_HUB_WEBHOOK_KEY  the key sent with it. Same value as HUB_WEBHOOK_KEY (or
#                      HOOK_KEY_PRISM) in the hub's .env. Either of the two
#                      unset = nothing is announced; the hub still reads
#                      /api/cmdhub/pending.
CMD_HUB_API_KEY=
CMD_HUB_WEBHOOK_URL=
CMD_HUB_WEBHOOK_KEY=
# How long to wait for the hub before giving up, in seconds
#CMD_HUB_TIMEOUT=10

# AWS S3 (used in the next module — Assets + upload)
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
