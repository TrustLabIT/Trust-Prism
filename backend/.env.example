# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas — paste your connection string (Atlas → Connect → Drivers)
# Looks like: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/trustprism?retryWrites=true&w=majority
MONGO_URI=

# JWT — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# PACE identity-hub provisioning token (create / enable / disable logins from PACE).
# The active token lives in a file at the backend root (provisioning_token),
# rotatable from PACE; this env var is the fallback.
PROVISIONING_TOKEN=

# AWS S3 (used in the next module — Assets + upload)
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
